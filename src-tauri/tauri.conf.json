{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scribe Voice", "version": "0.1.4", "identifier": "dev.scribe.voice",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Scribe Voice", "width": 1100, "height": 780, "minWidth": 900, "minHeight": 650, "center": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; font-src 'self'; object-src 'none'; frame-src 'none'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"], "shortDescription": "Voice input wherever you type", "category": "Productivity", "windows": { "nsis": { "installMode": "currentUser" } } }
}
